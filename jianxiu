<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --ink-deep: #1a1613; --ink-dark: #2b2520; --ink-mid: #4a423d;
  --ink-light: #7a7169; --ink-faint: #a89e94;
  --paper-light: #f5efe6; --paper-base: #ebe0cf;
  --paper-warm: #e0d3bd; --paper-deep: #cdbc9f;
  --cinnabar: #b8342e; --cinnabar-light: #d4503d; --cinnabar-deep: #8c2620;
  --jade: #3d7a6e; --jade-light: #5a9e90; --jade-deep: #2c5a50;
  --gold: #c9a96e; --gold-light: #e0c98a; --gold-deep: #a68a4e;
  --font-display: 'ZCOOL XiaoWei', 'Noto Serif SC', serif;
  --font-serif: 'Noto Serif SC', serif;
  --font-sans: 'Noto Sans SC', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-serif); color: var(--ink-dark);
  background: var(--paper-light); min-height: 100vh;
  overflow-x: hidden; position: relative; line-height: 1.7;
  display: flex; align-items: center; justify-content: center;
  padding: 40px 20px;
}

.bg-layer {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 0; overflow: hidden;
}
.bg-layer::before {
  content: ''; position: absolute; inset: 0;
  background-image:
