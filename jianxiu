let config = {};

// 初始化
function init() {
  loadConfig();
  renderVideos();
  renderDownloads();
}

// 加载配置
function loadConfig() {
  const saved = localStorage.getItem('siteConfig');
  config = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(defaultConfig));
  // 填充表单
  document.getElementById('cfg-name').value = config.name;
  document.getElementById('cfg-level').value = config.level;
  document.getElementById('cfg-sign').value = config.sign;
  document.getElementById('cfg-groupName').value = config.groupName;
  document.getElementById('cfg-groupNum').value = config.groupNum;
  document.getElementById('cfg-bilibili').value = config.bilibili;
  document.getElementById('cfg-fans').value = config.fans;
  document.getElementById('cfg-following').value = config.following;
  document.getElementById('cfg-likes').value = config.likes;
  document.getElementById('cfg-videos').value = config.videos;
  document.getElementById('cfg-realtime').checked = config.realtime;
}

// 从表单收集配置
function collectConfig() {
  config.name = document.getElementById('cfg-name').value;
  config.level = document.getElementById('cfg-level').value;
  config.sign = document.getElementById('cfg-sign').value;
  config.groupName = document.getElementById('cfg-groupName').value;
  config.groupNum = document.getElementById('cfg-groupNum').value;
  config.bilibili = document.getElementById('cfg-bilibili').value;
  config.fans = parseInt(document.getElementById('cfg-fans').value) || 0;
  config.following = parseInt(document.getElementById('cfg-following').value) || 0;
  config.likes = parseInt(document.getElementById('cfg-likes').value) || 0;
  config.videos = parseInt(document.getElementById('cfg-videos').value) || 0;
  config.realtime = document.getElementById('cfg-realtime').checked;
}

// 保存配置
function saveConfig() {
  collectConfig();
  localStorage.setItem('siteConfig', JSON.stringify(config));
  showToast('配置已保存');
}

// 渲染视频列表
function renderVideos() {
  const container = document.getElementById('videoList');
  container.innerHTML = '';
  config.videoList.forEach((v, i) => {
    const div = document.createElement('div');
    div.className = 'video-item';
    div.innerHTML = `
      <h3>视频 ${i+1}</h3>
      <button class="remove-btn" onclick="removeVideo(${i})">&times;</button>
      <div class="form-group">
        <label>视频标题</label>
        <input type="text" value="${v.title.replace(/"/g,'&quot;')}" onchange="config.videoList[${i}].title=this.value">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>BV号</label>
          <input type="text" value="${v.bvid}" onchange="config.videoList[${i}].bvid=this.value">
        </div>
        <div class="form-group">
          <label>时长</label>
          <input type="text" value="${v.duration}" onchange="config.videoList[${i}].duration=this.value">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>播放量</label>
          <input type="text" value="${v.play}" onchange="config.videoList[${i}].play=this.value">
        </div>
        <div class="form-group">
          <label>点赞数</label>
          <input type="text" value="${v.like}" onchange="config.videoList[${i}].like=this.value">
        </div>
        <div class="form-group">
          <label>收藏数</label>
          <input type="text" value="${v.fav}" onchange="config.videoList[${i}].fav=this.value">
        </div>
      </div>
    `;
    container.appendChild(div);
  });
}

function addVideo() {
  if (config.videoList.length >= 3) { showToast('最多添加3个视频'); return; }
  config.videoList.push({ title: '', bvid: '', play: '0', like: '0', fav: '0', duration: '00:00' });
  renderVideos();
}

function removeVideo(i) {
  config.videoList.splice(i, 1);
  renderVideos();
}

// 渲染下载列表
function renderDownloads() {
  const container = document.getElementById('downloadList');
  container.innerHTML = '';
  config.downloadList.forEach((d, i) => {
    const div = document.createElement('div');
    div.className = 'download-item';
    div.innerHTML = `
      <h3>下载项 ${i+1}</h3>
      <button class="remove-btn" onclick="removeDownload(${i})">&times;</button>
      <div class="form-group">
        <label>下载名称</label>
        <input type="text" value="${d.name.replace(/"/g,'&quot;')}" onchange="config.downloadList[${i}].name=this.value">
      </div>
      <div class="form-group">
        <label>描述</label>
        <input type="text" value="${d.desc.replace(/"/g,'&quot;')}" onchange="config.downloadList[${i}].desc=this.value">
      </div>
      <div class="form-group">
        <label>文件路径（如 files/xxx.zip 或外部链接）</label>
        <input type="text" value="${d.file.replace(/"/g,'&quot;')}" onchange="config.downloadList[${i}].file=this.value">
      </div>
    `;
    container.appendChild(div);
  });
}

function addDownload() {
  config.downloadList.push({ name: '新下载项', desc: '描述', file: 'files/file.zip' });
  renderDownloads();
}

function removeDownload(i) {
  config.downloadList.splice(i, 1);
  renderDownloads();
}

// 切换标签
function switchTab(tab, el) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.admin-sidebar a').forEach(a => a.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  el.classList.add('active');
}

// 登录
function doLogin() {
  const pwd = document.getElementById('loginPwd').value;
  const savedPwd = localStorage.getItem('adminPwd') || 'admin123';
  if (pwd === savedPwd) {
    document.getElementById('loginPage').style.display = 'none';
    document.getElementById('adminPage').style.display = 'block';
    init();
  } else {
    document.getElementById('loginError').style.display = 'block';
  }
}

function doLogout() {
  document.getElementById('adminPage').style.display = 'none';
  document.getElementById('loginPage').style.display = 'flex';
  document.getElementById('loginPwd').value = '';
  document.getElementById('loginError').style.display = 'none';
}

// 修改密码
function changePwd() {
  const p1 = document.getElementById('newPwd').value;
  const p2 = document.getElementById('newPwd2').value;
  if (!p1) { showToast('请输入新密码'); return; }
  if (p1 !== p2) { showToast('两次密码不一致'); return; }
  localStorage.setItem('adminPwd', p1);
  document.getElementById('newPwd').value = '';
  document.getElementById('newPwd2').value = '';
  showToast('密码修改成功');
}

// 导出配置
function exportConfig() {
  collectConfig();
  const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'site-config.json'; a.click();
  URL.revokeObjectURL(url);
  showToast('配置已导出');
}

// 导入配置
function importConfig(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    try {
      config = JSON.parse(ev.target.result);
      localStorage.setItem('siteConfig', JSON.stringify(config));
      loadConfig();
      renderVideos();
      renderDownloads();
      showToast('配置导入成功');
    } catch(err) {
      showToast('配置文件格式错误');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
}

// 恢复默认
function resetConfig() {
  if (!confirm('确定恢复默认配置？当前修改将丢失。')) return;
  config = JSON.parse(JSON.stringify(defaultConfig));
  localStorage.setItem('siteConfig', JSON.stringify(config));
  loadConfig();
  renderVideos();
  renderDownloads();
  showToast('已恢复默认配置');
}

// 导出完整网站包
async function exportSite() {
  collectConfig();
  localStorage.setItem('siteConfig', JSON.stringify(config));

  const progress = document.getElementById('exportProgress');
  const fill = document.getElementById('progressFill');
  const text = document.getElementById('progressText');
  progress.style.display = 'block';
  fill.style.width = '10%';
  text.textContent = '正在生成网站文件...';

  try {
    const zip = new JSZip();

    // 生成注入了配置的index.html
    fill.style.width = '30%';
    text.textContent = '正在生成首页...';
    let indexHtml = await fetch('index.html').then(r => r.text()).catch(() => '');
    if (!indexHtml) {
      // 如果fetch失败（本地打开时），用提示
      indexHtml = '<!DOCTYPE html><html><body><p>请在部署后的网站上使用后台导出功能</p></body></html>';
    }
    // 注入配置脚本
    const configScript = `<script>window.__SITE_CONFIG__=${JSON.stringify(config)};<\/script>`;
    indexHtml = indexHtml.replace('</head>', configScript + '</head>');
    zip.file('index.html', indexHtml);

    // ds.html
    fill.style.width = '50%';
    text.textContent = '正在生成赞赏页...';
    try {
      const dsHtml = await fetch('ds.html').then(r => r.text());
      zip.file('ds.html', dsHtml);
    } catch(e) {}

    // admin.html
    zip.file('admin.html', document.documentElement.outerHTML);

    // 图片和文件目录
    fill.style.width = '70%';
    text.textContent = '正在打包资源文件...';
    const assets = ['images/avatar.jpg', 'images/reward.jpg', 'images/video1.jpg', 'images/video2.jpg', 'images/video3.jpg'];
    for (const asset of assets) {
      try {
        const blob = await fetch(asset).then(r => r.blob());
        zip.file(asset, blob);
      } catch(e) {}
    }

    // files目录
    try {
      const fileList = await fetch('files/').then(r => r.text()).catch(() => '');
      // 尝试获取已知文件
      for (const dl of config.downloadList) {
        if (dl.file.startsWith('files/')) {
          try {
            const blob = await fetch(dl.file).then(r => r.blob());
            zip.file(dl.file, blob);
          } catch(e) {}
        }
      }
    } catch(e) {}

    fill.style.width = '90%';
    text.textContent = '正在压缩...';

    const content = await zip.generateAsync({ type: 'blob' }, (metadata) => {
      fill.style.width = metadata.percent + '%';
      text.textContent = '压缩中... ' + metadata.percent.toFixed(0) + '%';
    });

    const url = URL.createObjectURL(content);
    const a = document.createElement('a');
    a.href = url;
    a.download = '剑修哥_网站完整包.zip';
    a.click();
    URL.revokeObjectURL(url);

    fill.style.width = '100%';
    text.textContent = '导出完成！';
    showToast('网站包已导出');
    setTimeout(() => { progress.style.display = 'none'; }, 2000);

  } catch(err) {
    console.error(err);
    text.textContent = '导出失败：' + err.message;
    showToast('导出失败');
  }
}

// Toast
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}
