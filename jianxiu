<script>
(function () {
  'use strict';

  function initParticles() {
    const canvas = document.getElementById('particleCanvas');
    if (!canvas) return;
    // 移动端或低性能设备禁用粒子，避免卡顿
    if (window.innerWidth < 768 || navigator.hardwareConcurrency <= 4) {
      canvas.style.display = 'none';
      return;
    }
    const ctx = canvas.getContext('2d');
    let particles = [];
    const PARTICLE_COUNT = 12;
    let lastTime = 0;
    const FPS = 30;
    const frameInterval = 1000 / FPS;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    class Particle {
      constructor() { this.reset(true); }
      reset(initial) {
        this.x = Math.random() * canvas.width;
        this.y = initial ? Math.random() * canvas.height : -20;
        this.size = Math.random() * 6 + 4;
        this.speedY = Math.random() * 1 + 0.5;
        this.speedX = Math.random() * 1 - 0.5;
        this.rotation = Math.random() * Math.PI * 2;
        this.rotationSpeed = (Math.random() - 0.5) * 0.03;
        this.opacity = Math.random() * 0.4 + 0.15;
        this.type = Math.random() > 0.5 ? 'leaf' : 'petal';
        this.swayAmplitude = Math.random() * 30 + 10;
        this.swaySpeed = Math.random() * 0.02 + 0.01;
        this.swayOffset = Math.random() * Math.PI * 2;
      }
      update(time) {
        this.y += this.speedY;
        this.x += this.speedX + Math.sin(time * this.swaySpeed + this.swayOffset) * 0.5;
        this.rotation += this.rotationSpeed;
        if (this.y > canvas.height + 30 || this.x < -30 || this.x > canvas.width + 30) {
          this.reset(false);
          this.x = Math.random() * canvas.width;
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);
        ctx.globalAlpha = this.opacity;
        if (this.type === 'leaf') {
          ctx.fillStyle = '#5a9e90';
          ctx.beginPath();
          ctx.ellipse(0, 0, this.size, this.size * 0.35, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#3d7a6e';
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(-this.size, 0);
          ctx.lineTo(this.size, 0);
          ctx.stroke();
        } else {
          ctx.fillStyle = '#e8a5a0';
          ctx.beginPath();
          ctx.ellipse(0, 0, this.size * 0.8, this.size * 0.5, 0, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
    }

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push(new Particle());
    }

    let startTime = performance.now();
    function animate(timestamp) {
      requestAnimationFrame(animate);
      const delta = timestamp - lastTime;
      if (delta < frameInterval) return;
      lastTime = timestamp - (delta % frameInterval);
      const elapsed = performance.now() - startTime;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => { p.update(elapsed); p.draw(); });
    }
    requestAnimationFrame(animate);
  }

  async function fetchBilibiliStats() {
    const mid = '36518358';
    const apiUrl = `https://api.bilibili.com/x/web-interface/card?mid=${mid}`;
    const proxies = [
      `https://api.allorigins.win/raw?url=${encodeURIComponent(apiUrl)}`,
      `https://corsproxy.io/?url=${encodeURIComponent(apiUrl)}`,
      `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(apiUrl)}`
    ];
    for (const proxyUrl of proxies) {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 5000);
        const response = await fetch(proxyUrl, { signal: controller.signal });
        clearTimeout(timeoutId);
        const data = await response.json();
        if (data.code === 0 && data.data) {
          return {
            fans: data.data.follower,
            following: data.data.card.attention,
            likes: data.data.like_num,
            videos: data.data.archive_count
          };
        }
      } catch (e) {
        console.warn('代理失败，尝试下一个:', e.message);
      }
    }
    return null;
  }

  function initCountUp() {
    const statNumbers = document.querySelectorAll('.stat-number');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const target = parseInt(el.dataset.target, 10);
          animateCount(el, target);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });
    statNumbers.forEach(el => observer.observe(el));
  }

  function animateCount(el, target) {
    const duration = 2000;
    const startTime = performance.now();
    const start = 0;
    function easeOutExpo(t) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }
    function update(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = easeOutExpo(progress);
      const current = Math.floor(start + (target - start) * eased);
      el.textContent = current.toLocaleString();
      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        el.textContent = target.toLocaleString();
      }
    }
    requestAnimationFrame(update);
  }

  function initScrollReveal() {
    const revealElements = document.querySelectorAll(
      '.stats-section, .fan-section, .bili-section, .page-footer'
    );
    revealElements.forEach(el => el.classList.add('reveal'));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
    revealElements.forEach(el => observer.observe(el));
  }

  function initMouseGlow() {
    const hero = document.querySelector('.hero-section');
    if (!hero) return;
    const avatarOuter = document.querySelector('.avatar-outer-ring');
    if (!avatarOuter) return;
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width - 0.5) * 10;
      const y = ((e.clientY - rect.top) / rect.height - 0.5) * 10;
      avatarOuter.style.transform = `translate(${x}px, ${y}px)`;
    });
    hero.addEventListener('mouseleave', () => {
      avatarOuter.style.transform = 'translate(0, 0)';
    });
  }

  function initPageLoad() {
    document.body.style.opacity = '0';
    document.body.style.transition = 'opacity 0.8s ease';
    window.addEventListener('load', () => {
      setTimeout(() => { document.body.style.opacity = '1'; }, 100);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPageLoad();
    initParticles();
    initScrollReveal();
    initMouseGlow();

    // 先启动计数动画（用默认值兜底）
    initCountUp();

    // 异步获取B站实时数据，成功后更新数字
    fetchBilibiliStats().then(stats => {
      if (!stats) return;
      const statNumbers = document.querySelectorAll('.stat-number');
      const mapping = [stats.fans, stats.following, stats.likes, stats.videos];
      statNumbers.forEach((el, i) => {
        if (mapping[i] !== undefined) {
          const oldTarget = parseInt(el.dataset.target, 10);
          el.dataset.target = mapping[i];
          // 如果当前已经显示了旧值，重新播放动画到新值
          if (el.textContent !== '0' && oldTarget !== mapping[i]) {
            animateCount(el, mapping[i]);
          }
        }
      });
    });
  });
})();

function showRewardModal(amount) {
  const modal = document.getElementById('rewardModal');
