  opacity: 0.8;
}
.ink-wash {
  position: absolute; border-radius: 50%; filter: blur(60px);
  opacity: 0.08; animation: inkDrift 20s ease-in-out infinite;
}
.ink-wash-1 { width: 500px; height: 500px; background: radial-gradient(circle, var(--ink-deep) 0%, transparent 70%); top: -100px; left: -100px; }
.ink-wash-2 { width: 400px; height: 400px; background: radial-gradient(circle, var(--jade) 0%, transparent 70%); bottom: 10%; right: -50px; animation-delay: -7s; }
@keyframes inkDrift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -20px) scale(1.05); }
  66% { transform: translate(-20px, 20px) scale(0.95); }
}

.reward-container {
  position: relative; z-index: 2;
  max-width: 460px; width: 100%;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(12px);
  border: 1px solid var(--paper-deep);
  border-radius: 12px;
  padding: 48px 36px 40px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(26,22,19,0.1);
  animation: fadeInUp 0.8s ease;
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.stats-corner {
  position: absolute; width: 28px; height: 28px; border: 2px solid var(--gold);
}
.corner-tl { top: -1px; left: -1px; border-right: none; border-bottom: none; }
.corner-tr { top: -1px; right: -1px; border-left: none; border-bottom: none; }
.corner-bl { bottom: -1px; left: -1px; border-right: none; border-top: none; }
.corner-br { bottom: -1px; right: -1px; border-left: none; border-top: none; }

.seal-badge {
  width: 56px; height: 56px; margin: 0 auto 20px;
  background: var(--cinnabar); border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2px rgba(255,255,255,0.15), 0 4px 16px rgba(184,52,46,0.3);
  transform: rotate(-3deg);
}
.seal-badge span {
  font-family: var(--font-display); font-size: 28px; color: var(--paper-light);
  font-weight: 700;
}

.reward-title {
  font-family: var(--font-display); font-size: 36px; color: var(--ink-deep);
  letter-spacing: 10px; margin-bottom: 8px; font-weight: 400;
}
.title-divider {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; margin-bottom: 24px;
}
.divider-line {
  display: block; width: 60px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--ink-faint), transparent);
}
.divider-jade { color: var(--jade); font-size: 12px; }

.reward-subtitle {
  font-family: var(--font-serif); font-size: 15px; color: var(--ink-mid);
  letter-spacing: 3px; margin-bottom: 32px;
}

.qrcode-wrapper {
  width: 260px; height: 260px; margin: 0 auto 24px;
  background: white; border-radius: 12px; padding: 12px;
  box-shadow: 0 8px 32px rgba(26,22,19,0.12);
  border: 1px solid var(--paper-warm);
}
.qrcode-wrapper img {
  width: 100%; height: 100%; object-fit: cover; border-radius: 8px;
  display: block;
}

.pay-method {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 18px; background: rgba(7,193,96,0.1);
  border: 1px solid rgba(7,193,96,0.2); border-radius: 20px;
  font-family: var(--font-sans); font-size: 13px; color: #07c160;
  margin-bottom: 28px;
}
.pay-method svg { width: 16px; height: 16px; fill: #07c160; }

.reward-thanks {
  font-family: var(--font-display); font-size: 14px; color: var(--ink-light);
  letter-spacing: 4px; margin-bottom: 28px;
}

.back-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 28px; background: rgba(255,255,255,0.7);
  border: 1px solid var(--paper-deep); border-radius: 50px;
  font-family: var(--font-display); font-size: 15px; color: var(--ink-deep);
  text-decoration: none; letter-spacing: 3px;
  transition: all 0.3s ease;
}
.back-btn:hover {
  background: var(--ink-deep); color: var(--paper-light);
  border-color: var(--ink-deep); transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(26,22,19,0.2);
}
.back-btn svg { width: 16px; height: 16px; }

@media (max-width: 480px) {
  .reward-container { padding: 36px 24px 32px; }
  .reward-title { font-size: 28px; letter-spacing: 6px; }
  .qrcode-wrapper { width: 220px; height: 220px; }
}
</style>
</head>
<body>

<div class="bg-layer">
  <div class="ink-wash ink-wash-1"></div>
  <div class="ink-wash ink-wash-2"></div>
</div>

<div class="reward-container">
  <div class="stats-corner corner-tl"></div>
  <div class="stats-corner corner-tr"></div>
  <div class="stats-corner corner-bl"></div>
  <div class="stats-corner corner-br"></div>

  <div class="seal-badge"><span>劍</span></div>

  <h1 class="reward-title">赞赏支持</h1>

  <div class="title-divider">
