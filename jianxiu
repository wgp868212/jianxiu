  if (modal) {
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
  }
}

function closeRewardModal(event) {
  if (event && event.target !== event.currentTarget) return;
  const modal = document.getElementById('rewardModal');
  if (modal) {
    modal.classList.remove('show');
    document.body.style.overflow = '';
  }
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeRewardModal();
});

function toggleNavMenu() {
  const menu = document.querySelector('.nav-menu');
  if (menu) menu.classList.toggle('open');
}
document.addEventListener('click', (e) => {
  const menu = document.querySelector('.nav-menu');
  const toggle = document.querySelector('.nav-toggle');
  if (menu && menu.classList.contains('open') && !menu.contains(e.target) && !toggle.contains(e.target)) {
    menu.classList.remove('open');
  }
});

function copyQQGroup() {
  const groupNumber = '1003572258';
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(groupNumber).then(showToast);
  } else {
    const textarea = document.createElement('textarea');
    textarea.value = groupNumber;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try { document.execCommand('copy'); showToast(); }
    catch (e) { console.error('複製失敗', e); }
    document.body.removeChild(textarea);
  }
}

function showToast() {
  const toast = document.getElementById('toast');
  if (!toast) return;
  toast.classList.add('show');
  setTimeout(() => { toast.classList.remove('show'); }, 2000);
}

